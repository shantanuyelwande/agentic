# Required: Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Claude model to use (default: claude-sonnet-4-6)
CLAUDE_MODEL=claude-sonnet-4-6

# Infrastructure
REDIS_URL=redis://localhost:6379/0

# Task Configuration
TASK_TTL_SECONDS=86400          # Task data retention (24 hours)
CHECKPOINT_INTERVAL=3           # Save progress every N steps
SKILLS_DIR=/app/.claude/skills  # Path to skills directory

# Optional: API server URL for client (default: http://localhost:8000)
AGENT_API_URL=http://localhost:8000

# Optional: Worker configuration
WORKER_ID=worker-1              # Worker identifier (defaults to hostname)
